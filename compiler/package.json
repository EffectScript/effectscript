{
  "name": "effectscript-compiler",
  "version": "0.2.0",
  "description": "EffectScript compiler — a safer JavaScript with full TypeScript interop",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/effectscript/effectscript.git",
    "directory": "compiler"
  },
  "homepage": "https://github.com/effectscript/effectscript#readme",
  "bugs": {
    "url": "https://github.com/effectscript/effectscript/issues"
  },
  "bin": {
    "esc": "./dist/bin.js"
  },
  "main": "./dist/compiler.js",
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "effectscript",
    "compiler",
    "programming-language",
    "javascript",
    "typescript",
    "null-safety",
    "pattern-matching",
    "algebraic-data-types"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "typescript": "^5.7.0"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "vitest": "^3.0.0"
  }
}
